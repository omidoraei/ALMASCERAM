{
  "name": "almasceram-catalog",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "audit:deps": "npm audit --omit=dev",
    "audit:secrets": "node -e \"const fs=require('fs'),p=require('path');const re=/(api[_-]?key|secret|password|token)\\s*[:=]\\s*[\\\"\\']/i;function walk(d){for(const f of fs.readdirSync(d)){const fp=p.join(d,f);const s=fs.statSync(fp);if(s.isDirectory())walk(fp);else if(/\\.(ts|tsx|js|jsx)$/.test(f)){const c=fs.readFileSync(fp,'utf8');if(re.test(c)&&!/test|spec|\\.example|README|//|\\/\\*/.test(c.split('\\n').find(l=>re.test(l))||''))console.log(fp+': '+c.split('\\n').find(l=>re.test(l)))}}}\nwalk('src')\""
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.109.0",
    "framer-motion": "^12.35.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.86.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.49.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/ui": "^2.1.5",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1",
    "vitest": "^2.1.5"
  }
}
