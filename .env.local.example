# =============================================================================
# متغیرهای محیطی — پلتفرم کاتالوگ کاشی و سرامیک
# این فایل را کپی کرده و به .env.local تغییر نام دهید، سپس مقادیر واقعی را وارد کنید.
# هرگز فایل .env.local را کامیت نکنید.
# =============================================================================

# --- Supabase (Project Settings > API) ---
# آدرس عمومی پروژه Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# کلید عمومی (anon) — امن برای استفاده در کلاینت، محدود توسط RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# کلید سرویس (service_role) — فقط سمت سرور، هرگز به کلاینت ارسال نشود (Least Privilege)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- اپلیکیشن ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=کاتالوگ کاشی و سرامیک

# --- ایمیل OTP (در صورت استفاده از SMTP سفارشی در Supabase Auth) ---
# در غیر این صورت از سرویس پیش‌فرض Supabase استفاده می‌شود.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=noreply@example.com

# --- امنیت ---
# رشته تصادفی قوی برای امضای توکن‌های داخلی در صورت نیاز
APP_SECRET=change-me-to-a-random-64-char-string
