# Public browser credentials (safe only with RLS)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public site URL — used for canonical links, JSON-LD, sitemap, og:url
VITE_SITE_URL=https://almasceram.ir

# Server/scripts only — never expose through VITE_ prefix
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: redirect origin for magic link emails (defaults to VITE_SITE_URL)
# SUPABASE_AUTH_REDIRECT_URL=https://almasceram.ir/auth/callback
